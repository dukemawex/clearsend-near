# --- NEAR ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_ESCROW_CONTRACT=clearsend-intents-1793672696.testnet
NEXT_PUBLIC_VERIFIER_ACCOUNT=clearsend-verifier-1793672761.testnet
# NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.fastnear.com
# Function-call access key of the verifier account (can only call `attest`). Never commit.
AGENT_PRIVATE_KEY=
# --- AI verifier / agent (Meta Model API, OpenAI-compatible) ---
MODEL_API_KEY=
VERIFIER_BASE_URL=https://api.meta.ai/v1
VERIFIER_MODEL=muse-spark-1.3-contributor
VERIFIER_FALLBACK_MODEL=muse-spark-1.2-contributor
# Global cap on AI calls per day per server instance (per-IP limits also apply)
AI_DAILY_CAP=300
# Optional NEAR AI Cloud (https://cloud.near.ai)
NEARAI_API_KEY=
NEARAI_MODEL=
# --- Links ---
ESCROW_LINK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# --- Flights (optional priced source; open data works without keys) ---
RAPIDAPI_KEY=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
# --- NEAR Intents 1Click ---
# ONECLICK_JWT=          # optional, lowers fees
# INTENTS_EXECUTE=1      # DANGER: real mainnet quotes with deposit addresses. Default: dry:true only
